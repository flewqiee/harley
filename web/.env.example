# Bu dosyayı ".env" olarak kopyalayıp doldur. .env ASLA commit'lenmez.

PORT=8080
APP_URL=https://harleyai.shop

# Oturum gizli anahtarı (rastgele uzun bir dize üret)
SESSION_SECRET=degistir-bunu-rastgele-uzun-bir-anahtar

# Admin (siparişi elle "ödendi" işaretlemek için; ödeme sağlayıcı entegre olunca gerekmeyebilir)
ADMIN_TOKEN=degistir-bunu-gizli-admin-tokeni

# Fiyat
PRICE=299
CURRENCY=TRY
LICENSE_DAYS=0

# Lisans özel anahtarı (Harley uygulamasındaki açık anahtarla EŞLEŞEN özel anahtar)
# Örn. proje kökündeki app/premium/keys/private.pem dosyasını sunucuya koy ve yolunu ver:
HARLEY_LICENSE_KEY_PATH=./secrets/private.pem
